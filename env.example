# ------------------------------------------------------------------
# Copy this file to `.env` and adjust values before running locally.
# Never commit the populated `.env` file to source control.
# ------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
DB_SCHEMA_BOOTSTRAP=false
APP_PUBLIC_PORT=80
TRUST_PROXY=false
AUTH_COOKIE_SECURE=
ALLOW_INSECURE_HTTP_AUTH=false
RUN_DB_MIGRATIONS=true
MIGRATIONS_FAIL_OPEN=false

# Database
# For local Node: mysql://assistant:<your MYSQL_PASSWORD>@localhost:3306/ai_knowledge_db
DATABASE_URL=
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=ai_knowledge_db
MYSQL_USER=assistant
MYSQL_PASSWORD=

# User metadata
OWNER_OPEN_ID=
ADMIN_EMAIL=admin@admin.local
# Required only when creating the first administrator (12–128 characters).
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Frontend branding
VITE_APP_TITLE=AI Knowledge Assistant
VITE_APP_LOGO=/logo.svg

# Forge API (client + server)
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=https://forge.butterfly-effect.dev
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# RAG / LLM configuration
# Use "LLM" in the admin menu to switch between local (Ollama/Forge) and external (OpenRouter) providers.
# Docker Compose: use http://ollama:11434 (service name). Localhost only if app runs on the host, not in a container.
# docker-compose.yml overrides both to http://ollama:11434 for the app service.
OLLAMA_URL=http://ollama:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma2:2b
LLM_MODEL_GENERATION=gemma2:2b
EMBEDDING_MODEL=bge-m3
OLLAMA_EMBEDDING_MODEL=bge-m3
RERANKER_URL=
RERANK_MODEL=bge-reranker-v2-m3
RERANK_ENABLED=true
RAG_RERANK_ENABLED=true
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.9
LLM_REPEAT_PENALTY=1.1
RAG_CONFIG_PATH=./config/rag.json
RAG_SYSTEM_PROMPT_PATH=./prompts/system.sanext.txt
# OCR table extraction is disabled. Legacy TABLE_EXTRACTOR_* values are ignored.
# Max estimated tokens for sending full company markdown to the LLM (else RAG)
COMPANY_FULL_MD_MAX_TOKENS=8000

# Sync certificates & passports from sanext.ru (periodic)
# SANEXT_SYNC_DISABLED=false
SANEXT_SYNC_INTERVAL_MS=86400000
SANEXT_SYNC_STARTUP_DELAY_MS=60000
# Optional: force uploadedBy for synced docs (otherwise first admin)
# SANEXT_SYNC_UPLOADER_ID=

# Integrations
BITRIX24_WEBHOOK_URL=
# Incoming requests must send Authorization: Bearer <this secret> (32+ characters).
BITRIX24_INBOUND_SECRET=
# Comma-separated origins allowed to embed the chat widget (use * for any origin)
WIDGET_ALLOWED_ORIGINS=
# Public URL used in widget embed snippet (optional; auto-detected from Host if empty)
PUBLIC_APP_URL=

# Observability / misc
WEAVIATE_URL=http://localhost:8080

